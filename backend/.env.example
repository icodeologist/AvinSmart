SERVER_ADDRESS=:8080
# Render sets PORT automatically. Leave SERVER_ADDRESS unset there so the
# backend binds to Render's assigned port; SERVER_ADDRESS is useful locally.
# PORT=10000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/avinsmart?sslmode=disable
APP_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ISSUER=avinsmart-api
JWT_EXPIRY_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Production values (set these in Render, never commit them):
# APP_ENV=production
# DATABASE_URL=postgres://<user>:<password>@<private-db-host>:5432/avinsmart?sslmode=require
# JWT_SECRET=<random-secret-at-least-32-characters>
# JWT_ISSUER=avinsmart-api
# JWT_EXPIRY_HOURS=24
# CORS_ALLOWED_ORIGINS=https://<frontend-domain>
